  "pwaHelpers": {
    "getRestaurantById": "function(id) { return restaurants.tokyo.concat(restaurants.hakone, restaurants.kyoto, restaurants.osaka).find(r => r.id === id); }",
    "getMealsForDay": "function(day) { return mealPlanByDay.find(m => m.day === day); }",
    "getCoordinatesForId": "function(id) { const r = getRestaurantById(id); return r ? r.coordinates : null; }",
    "mapPinColors": {
      "restaurant": "#FF6B6B",
      "attraction": "#4ECDC4",
      "hotel": "#45B7D1",
      "market": "#96CEB4",
      "shopping": "#FFEAA7"
    },
